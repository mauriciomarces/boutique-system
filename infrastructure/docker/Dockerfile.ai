FROM python:3.12-slim

WORKDIR /app

COPY backend/services/ai-service/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/services/ai-service /app

ENV PYTHONPATH=/app
ENV PORT=4008

EXPOSE 4008

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "4008"]
