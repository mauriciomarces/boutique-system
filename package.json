{
  "name": "boutique-system",
  "version": "1.0.0",
  "description": "Boutique microservices platform",
  "private": true,
  "scripts": {
    "dev": "docker compose up",
    "dev:build": "docker compose up --build",
    "dev:frontend": "pnpm --filter frontend dev -- --host 0.0.0.0",
    "dev:gateway": "pnpm --filter api start:dev",
    "docker:up": "docker compose up -d",
    "docker:build": "docker compose build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "keywords": [
    "microservices",
    "boutique",
    "docker",
    "nestjs",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.24.0",
  "workspaces": [
    "frontend/*",
    "backend/gateway",
    "backend/services/*"
  ]
}