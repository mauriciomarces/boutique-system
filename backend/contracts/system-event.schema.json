{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SposaBellaSystemEvent",
  "description": "Contrato común para eventos operativos. usuario_id es null cuando no existe un actor identificable, como un intento de login con una cuenta inexistente.",
  "type": "object",
  "required": [
    "event_id",
    "service",
    "tipo_evento",
    "entidad",
    "timestamp",
    "resultado"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 1, "maxLength": 120, "description": "Identificador único e idempotente del evento lógico." },
    "service": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Servicio emisor. Ej: sales-service.",
      "enum": [
        "users-service",
        "products-service",
        "inventory-service",
        "sales-service",
        "notifications-service"
      ]
    },
    "usuario_id": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tipo_evento": {
      "type": "string",
      "enum": [
        "LOGIN",
        "LOGOUT",
        "LOGIN_FALLIDO",
        "VENTA_CREADA",
        "VENTA_ANULADA",
        "VENTA_ANULACION_SOLICITADA",
        "VENTA_ANULACION_EN_PROCESO",
        "VENTA_MODIFICADA",
        "PAGO_REGISTRADO",
        "PRODUCTO_CREADO",
        "PRODUCTO_MODIFICADO",
        "STOCK_MODIFICADO",
        "PRECIO_MODIFICADO",
        "USUARIO_CREADO",
        "USUARIO_MODIFICADO",
        "USUARIO_DESACTIVADO",
        "CAMBIO_ROL"
      ]
    },
    "entidad": { "type": "string", "minLength": 1, "maxLength": 80 },
    "entidad_id": {
      "type": ["integer", "string", "null"],
      "maximum": 9007199254740991,
      "maxLength": 120
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "resultado": { "type": "string", "enum": ["EXITOSO", "FALLIDO"] },
    "ip": { "type": "string", "maxLength": 64 },
    "metadata": {
      "type": "object",
      "maxProperties": 20,
      "propertyNames": { "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,49}$" },
      "additionalProperties": {
        "type": ["string", "number", "boolean"],
        "maxLength": 200
      }
    }
  },
  "additionalProperties": false
}
