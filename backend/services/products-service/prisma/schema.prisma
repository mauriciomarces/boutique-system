generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model categorias {
  id             BigInt      @id @default(autoincrement())
  nombre         String      @unique(map: "nombre") @db.VarChar(100)
  descripcion    String?     @db.VarChar(255)
  estado         String      @default("ACTIVO") @db.VarChar(20)
  creado_en      DateTime    @db.DateTime(0)
  actualizado_en DateTime    @db.DateTime(0)
  productos      productos[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model productos {
  id             BigInt      @id @default(autoincrement())
  categoria_id   BigInt
  nombre         String      @db.VarChar(150)
  descripcion    String?     @db.Text
  estado         String      @default("ACTIVO") @db.VarChar(20)
  creado_en      DateTime    @db.DateTime(0)
  actualizado_en DateTime    @db.DateTime(0)
  categorias     categorias  @relation(fields: [categoria_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "productos_ibfk_1")
  variantes      variantes[]

  @@index([categoria_id], map: "categoria_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model variantes {
  id             BigInt    @id @default(autoincrement())
  producto_id    BigInt
  sku            String    @unique(map: "sku") @db.VarChar(100)
  talla          String?   @db.VarChar(50)
  color          String?   @db.VarChar(50)
  precio         Decimal   @db.Decimal(10, 2)
  estado         String    @default("ACTIVO") @db.VarChar(20)
  creado_en      DateTime  @db.DateTime(0)
  actualizado_en DateTime  @db.DateTime(0)
  productos      productos @relation(fields: [producto_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "variantes_ibfk_1")

  @@index([producto_id], map: "producto_id")
}
