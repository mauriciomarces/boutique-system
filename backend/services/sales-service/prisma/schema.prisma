generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model clientes {
  id             BigInt   @id @default(autoincrement())
  nombre         String   @db.VarChar(100)
  apellido       String   @db.VarChar(100)
  telefono       String?  @db.VarChar(30)
  correo         String?  @db.VarChar(150)
  estado         String   @default("ACTIVO") @db.VarChar(20)
  creado_en      DateTime @default(now()) @db.DateTime(0)
  actualizado_en DateTime @updatedAt @db.DateTime(0)
  ventas         ventas[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model detalle_ventas {
  id                   BigInt  @id @default(autoincrement())
  venta_id             BigInt
  variante_producto_id BigInt
  cantidad             Int
  precio_unitario      Decimal @db.Decimal(10, 2)
  subtotal             Decimal @db.Decimal(12, 2)
  ventas               ventas  @relation(fields: [venta_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "detalle_ventas_ibfk_1")
  tareas_anulacion     tareas_anulacion[]

  @@index([venta_id], map: "venta_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model pagos {
  id             BigInt    @id @default(autoincrement())
  venta_id       BigInt
  metodo_pago    String    @db.VarChar(50)
  monto          Decimal   @db.Decimal(12, 2)
  estado         String    @default("PENDIENTE") @db.VarChar(30)
  fecha_pago     DateTime? @db.DateTime(0)
  creado_en      DateTime  @db.DateTime(0)
  actualizado_en DateTime  @db.DateTime(0)
  ventas         ventas    @relation(fields: [venta_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "pagos_ibfk_1")

  @@index([venta_id], map: "venta_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model ventas {
  id             BigInt           @id @default(autoincrement())
  cliente_id     BigInt?
  fecha_venta    DateTime         @db.DateTime(0)
  estado         String           @default("CONFIRMADA") @db.VarChar(30)
  subtotal       Decimal          @db.Decimal(12, 2)
  total          Decimal          @db.Decimal(12, 2)
  creado_en      DateTime         @db.DateTime(0)
  actualizado_en DateTime         @db.DateTime(0)
  detalle_ventas detalle_ventas[]
  pagos          pagos[]
  clientes       clientes?        @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "ventas_ibfk_1")
  operaciones_anulacion operaciones_anulacion[]

  @@index([cliente_id], map: "cliente_id")
}

model operaciones_anulacion {
  id                BigInt   @id @default(autoincrement())
  venta_id          BigInt   @unique(map: "uq_operaciones_anulacion_venta")
  estado            String   @default("PENDIENTE") @db.VarChar(24)
  solicitada_por_id BigInt?
  motivo            String?  @db.VarChar(500)
  intentos          Int      @default(0)
  ultimo_error      String?  @db.Text
  lease_token       String?  @db.VarChar(64)
  lease_hasta       DateTime? @db.DateTime(0)
  creada_en         DateTime @default(now()) @db.DateTime(0)
  iniciada_en       DateTime? @db.DateTime(0)
  completada_en     DateTime? @db.DateTime(0)
  actualizada_en    DateTime @default(now()) @updatedAt @db.DateTime(0)

  ventas            ventas @relation(fields: [venta_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_operaciones_anulacion_venta")
  tareas            tareas_anulacion[]
  eventos           eventos_anulacion[]

  @@index([estado, lease_hasta], map: "idx_operaciones_anulacion_recuperacion")
}

model tareas_anulacion {
  id                       BigInt   @id @default(autoincrement())
  operacion_id             BigInt
  detalle_venta_id         BigInt
  variante_producto_id     BigInt
  cantidad                 Int
  estado                   String   @default("PENDIENTE") @db.VarChar(24)
  idempotency_key          String   @unique(map: "uq_tarea_anulacion_idempotencia") @db.VarChar(191)
  movimiento_inventario_id BigInt?
  intentos                 Int      @default(0)
  ultimo_error             String?  @db.Text
  iniciada_en              DateTime? @db.DateTime(0)
  completada_en            DateTime? @db.DateTime(0)
  creada_en                DateTime @default(now()) @db.DateTime(0)
  actualizada_en           DateTime @default(now()) @updatedAt @db.DateTime(0)

  operacion                operaciones_anulacion @relation(fields: [operacion_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_tarea_anulacion_operacion")
  detalle                  detalle_ventas @relation(fields: [detalle_venta_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_tarea_anulacion_detalle")
  eventos                  eventos_anulacion[]

  @@unique([operacion_id, detalle_venta_id], map: "uq_tarea_anulacion_detalle")
  @@index([operacion_id, estado], map: "idx_tareas_anulacion_estado")
  @@index([detalle_venta_id], map: "fk_tarea_anulacion_detalle")
}

model eventos_anulacion {
  id              BigInt   @id @default(autoincrement())
  operacion_id    BigInt
  tarea_id        BigInt?
  tipo_evento     String   @db.VarChar(50)
  estado_anterior String?  @db.VarChar(24)
  estado_nuevo    String?  @db.VarChar(24)
  actor_id        BigInt?
  mensaje         String?  @db.Text
  metadata        Json?    @db.Json
  creado_en       DateTime @default(now()) @db.DateTime(0)

  operacion       operaciones_anulacion @relation(fields: [operacion_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_eventos_anulacion_operacion")
  tarea           tareas_anulacion? @relation(fields: [tarea_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_eventos_anulacion_tarea")

  @@index([operacion_id, creado_en], map: "idx_eventos_anulacion_operacion_fecha")
  @@index([tarea_id, creado_en], map: "idx_eventos_anulacion_tarea_fecha")
}
