generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model compras {
  id              BigInt            @id @default(autoincrement())
  proveedor_id    BigInt
  fecha_compra    DateTime          @db.DateTime(0)
  estado          String            @default("REGISTRADA") @db.VarChar(30)
  total           Decimal           @db.Decimal(12, 2)
  creado_en       DateTime          @db.DateTime(0)
  actualizado_en  DateTime          @db.DateTime(0)
  proveedores     proveedores       @relation(fields: [proveedor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "compras_ibfk_1")
  detalle_compras detalle_compras[]

  @@index([proveedor_id], map: "proveedor_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model detalle_compras {
  id                   BigInt  @id @default(autoincrement())
  compra_id            BigInt
  variante_producto_id BigInt
  cantidad             Int
  costo_unitario       Decimal @db.Decimal(10, 2)
  subtotal             Decimal @db.Decimal(12, 2)
  compras              compras @relation(fields: [compra_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "detalle_compras_ibfk_1")

  @@index([compra_id], map: "compra_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model existencias {
  id                   BigInt   @id @default(autoincrement())
  variante_producto_id BigInt   @unique(map: "variante_producto_id")
  cantidad             Int      @default(0)
  cantidad_minima      Int      @default(0)
  actualizado_en       DateTime @db.DateTime(0)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model movimientos_inventario {
  id                   BigInt   @id @default(autoincrement())
  variante_producto_id BigInt
  tipo_movimiento      String   @db.VarChar(30)
  cantidad             Int
  referencia_tipo      String?  @db.VarChar(30)
  referencia_id        BigInt?
  motivo               String?  @db.VarChar(255)
  creado_en            DateTime @db.DateTime(0)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model proveedores {
  id             BigInt    @id @default(autoincrement())
  nombre         String    @db.VarChar(150)
  telefono       String?   @db.VarChar(30)
  correo         String?   @db.VarChar(150)
  direccion      String?   @db.VarChar(255)
  estado         String    @default("ACTIVO") @db.VarChar(20)
  creado_en      DateTime  @db.DateTime(0)
  actualizado_en DateTime  @db.DateTime(0)
  compras        compras[]
}
