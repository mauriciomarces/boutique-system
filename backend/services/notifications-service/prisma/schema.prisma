generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model notificaciones {
  id              BigInt    @id @default(autoincrement())
  usuario_id      BigInt
  tipo            String    @db.VarChar(50)
  titulo          String    @db.VarChar(150)
  mensaje         String    @db.Text
  canal           String    @db.VarChar(30)
  estado          String    @default("PENDIENTE") @db.VarChar(30)
  referencia_tipo String?   @db.VarChar(50)
  referencia_id   BigInt?
  enviado_en      DateTime? @db.DateTime(0)
  leido_en        DateTime? @db.DateTime(0)
  creado_en       DateTime  @db.DateTime(0)
}
