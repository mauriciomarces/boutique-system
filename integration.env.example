# Copy to .env.integration.local (ignored by Git) and replace every marker.
# Never copy values from the development .env. Do not use this template to start services.
INTEGRATION_MYSQL_APP_PASSWORD=SET_TEST_PASSWORD_TO_MATCH_THE_CURRENT_SERVICE_ADAPTER
INTEGRATION_MYSQL_ROOT_PASSWORD=SET_A_UNIQUE_TEST_ONLY_ROOT_PASSWORD
INTEGRATION_SALES_DATABASE_URL=mysql://boutique:REPLACE_ME@mysql-sales:3306/boutique_sales
INTEGRATION_INVENTORY_DATABASE_URL=mysql://boutique:REPLACE_ME@mysql-inventory:3306/boutique_inventory
INTEGRATION_INTERNAL_SERVICE_SECRET=SET_A_UNIQUE_TEST_ONLY_AUTH_SECRET
SALES_INVENTORY_INTERNAL_SECRET=SET_ONE_UNIQUE_TEMPORARY_SECRET_SHARED_BY_TEST_SERVICES
